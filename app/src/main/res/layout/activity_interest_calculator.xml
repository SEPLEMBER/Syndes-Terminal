<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Финансовый калькулятор"
            android:textColor="#00FFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Сумма вклада -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Начальная сумма (₽):"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="100000"
            android:inputType="numberDecimal"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/errAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF3333" android:textSize="12sp" android:layout_marginBottom="16dp" android:visibility="gone"/>

        <!-- Ставка -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Процентная ставка (% годовых):"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="7"
            android:inputType="numberDecimal"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/errRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF3333" android:textSize="12sp" android:layout_marginBottom="16dp" android:visibility="gone"/>

        <!-- Срок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Срок:"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <EditText
                android:id="@+id/etPeriod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="3"
                android:inputType="number"
                android:textColor="#00FFFF"
                android:textColorHint="#008B8B"
                android:backgroundTint="#00FFFF" />
            <Spinner
                android:id="@+id/spinnerPeriodUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00FFFF" />
        </LinearLayout>
        <TextView android:id="@+id/errPeriod" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF3333" android:textSize="12sp" android:layout_marginBottom="16dp" android:visibility="gone"/>

        <!-- Ежемесячное пополнение -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ежемесячное пополнение (₽):"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etMonthlyDeposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberDecimal"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="16dp" />

        <!-- Капитализация -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Периодичность капитализации:"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerCapitalization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="16dp" />

        <!-- Инфляция -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Инфляция (% годовых, необязательно):"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etInflation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberDecimal"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="24dp" />

        <!-- Кнопка -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Рассчитать"
            android:textColor="#0A0A0A"
            android:backgroundTint="#00FFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <!-- Результат -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>
</ScrollView>
