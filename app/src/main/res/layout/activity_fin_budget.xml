<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Калькулятор бюджета"
            android:textColor="#00FFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Общая сумма бюджета -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Общая сумма бюджета (₽):"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etBudgetAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="100"
            android:inputType="numberDecimal"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="4dp" />
        
        <TextView 
            android:id="@+id/errAmount" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:textColor="#FF3333" 
            android:textSize="12sp" 
            android:layout_marginBottom="16dp" 
            android:visibility="gone" />

        <!-- Период в днях -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="На сколько дней этот бюджет:"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPeriodDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="7"
            android:inputType="number"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="4dp" />
            
        <TextView 
            android:id="@+id/errDays" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:textColor="#FF3333" 
            android:textSize="12sp" 
            android:layout_marginBottom="24dp" 
            android:visibility="gone" />

        <!-- Кнопка -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Рассчитать лимиты"
            android:textColor="#0A0A0A"
            android:backgroundTint="#00FFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <!-- Результат -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>
</ScrollView>
