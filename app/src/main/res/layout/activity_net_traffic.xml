<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Калькулятор трафика"
            android:textColor="#00FFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Общий объём трафика + Выбор единицы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Общий объём трафика:"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/etTotalTraffic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="50"
                android:inputType="numberDecimal"
                android:textColor="#00FFFF"
                android:textColorHint="#008B8B"
                android:backgroundTint="#00FFFF" />

            <Spinner
                android:id="@+id/spinnerTrafficUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00FFFF" />
        </LinearLayout>
        
        <TextView 
            android:id="@+id/errTraffic" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:textColor="#FF3333" 
            android:textSize="12sp" 
            android:layout_marginBottom="16dp" 
            android:visibility="gone" />

        <!-- Период в днях -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Период (дней):"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPeriodDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="10"
            android:inputType="number"
            android:textColor="#00FFFF"
            android:textColorHint="#008B8B"
            android:backgroundTint="#00FFFF"
            android:layout_marginBottom="4dp" />
            
        <TextView 
            android:id="@+id/errDays" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:textColor="#FF3333" 
            android:textSize="12sp" 
            android:layout_marginBottom="24dp" 
            android:visibility="gone" />

        <!-- Кнопка -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Рассчитать лимиты"
            android:textColor="#0A0A0A"
            android:backgroundTint="#00FFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <!-- Результат -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>
</ScrollView>
