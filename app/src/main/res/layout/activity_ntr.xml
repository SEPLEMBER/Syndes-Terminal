<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:orientation="vertical">

    <!-- Терминал вывода (скроллбар полностью скрыт для чистоты UI) -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="20dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvTerminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4"
            android:shadowColor="#3000FFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="4"
            android:text="NUMTRAP v3.16\n\n[ МОДУЛИ ]\n01. Финансовые проценты\n02. Бюджет\n03. Налоги\n04. УСН, Патент, Страхование ИП\n05. Бюджет сетевого трафика\n06. Доход\n07. Скорость x Расстояние\n08. RSI, DUI (External)\n09. Rush (External)\n10. PurMoney (External)\n11. Запасы и потребление (External)\n12. Распределение ресурсов (External)\n13. Управление ресурсами (External)\n14. Динамический эффект (External)\n15. Накопительный эффект (External)\n16. Спокойствие при обретении ресурса (External)\n17. Гео (External)\n18. Даты (External)\n19. CPI + ROI (External)\n20. Покупка товара (External)\n21. Затраты времени (External)\n22. Скорость шага (External)\n23. Ресурсный распределитель\n24. Прочее 1 (External)\n25. Прочее 2 (External)\n\n> ОЖИДАНИЕ ВВОДА_"
            android:textColor="#00AAAA"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </ScrollView>

    <!-- Тонкий неоновый разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="#00FFFF" />

    <!-- Панель ввода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0A0A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=">"
            android:textColor="#00FFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="введите номер..."
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#00FFFF"
            android:textColorHint="#005555"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>
