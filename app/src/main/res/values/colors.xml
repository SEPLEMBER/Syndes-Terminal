<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ФОН: Глубокий темный с легким синеватым отливом для лучшего сочетания с неоном -->
    <color name="terminal_bg">#DD070F18</color>         <!-- Полупрозрачный темно-синий/черный -->
    <color name="terminal_panel">#020813</color>        <!-- Плотный темный для панелей -->

    <!-- ТЕКСТ: Максимально яркие неоновые голубые и циановые оттенки -->
    <color name="terminal_text">#00E5FF</color>   <!-- Яркий Электрический Циан (основной текст, отлично читается) -->
    <color name="color_command">#00A3FF</color>   <!-- Насыщенный Неоново-Голубой для команд -->
    
    <!-- СЛУЖЕБНЫЕ И АКЦЕНТЫ: Яркие, контрастные, но не уходящие в темноту -->
    <color name="color_info">#00FFC2</color>      <!-- Светящаяся Бирюза (яркий неон для инфо-сообщений/путей) -->
    <color name="color_error">#E040FB</color>     <!-- Неоновый Пурпур/Маджента (сочный контраст для ошибок в синей гамме) -->
</resources>
